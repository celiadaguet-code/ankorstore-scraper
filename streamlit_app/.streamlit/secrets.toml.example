# ============================================================================
# Streamlit Secrets — Ankorstore Catalog Scraper
# ============================================================================
#
# Pour activer l'authentification en LOCAL :
#   1. Copie ce fichier en `.streamlit/secrets.toml` (sans le .example)
#   2. Change `app_password` ci-dessous par un vrai mot de passe
#
# Pour déployer sur Streamlit Cloud :
#   - Ne PAS committer secrets.toml dans git (déjà dans .gitignore)
#   - Aller dans Settings → Secrets sur le dashboard Streamlit Cloud
#   - Coller le contenu de ce fichier en remplaçant les valeurs
# ============================================================================

# Mot de passe partagé avec l'équipe AE (le rotate tous les 6 mois si paranoïa)
app_password = "AnkorScrape2026!"

# ============================================================================
# Phase 2 — Google Sheets + Drive (à brancher dans une étape suivante)
# ============================================================================

# ID du Google Sheet "Historique des scrapes" (récupéré dans l'URL du Sheet)
# gsheet_history_id = "1ABC...xyz"

# ID du dossier Google Drive où archiver les xlsx
# gdrive_folder_id = "1XYZ...abc"

# Credentials Service Account Google (JSON aplati en TOML)
# [gcp_service_account]
# type = "service_account"
# project_id = "ankorstore-scraper-..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "scraper@ankorstore-scraper-....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
